# ---------------------------------------------------------------------------
# Bitaqati — example configuration. Values are DESCRIPTIVE PLACEHOLDERS, not secrets.
# Copy to apps/api/.env for local development. Never commit real values.
# In staging/production, missing critical values make the API refuse to start.
# ---------------------------------------------------------------------------

# --- API (apps/api) ---
NODE_ENV=development                 # development | test | production
APP_ENV=development                  # development | test | staging | production (staging is as strict as production)
PORT=4000
DATABASE_URL=postgresql://bitaqati:bitaqati@localhost:5432/bitaqati_dev
REDIS_URL=redis://localhost:6379     # required in staging/production (rate limits, queues)
JWT_ACCESS_SECRET=<random 48+ chars from your secret manager>
MFA_ENCRYPTION_KEY=<64 hex chars (32 bytes) from your secret manager>
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
PUBLIC_API_URL=http://localhost:4000 # must be https:// in staging/production
PUBLIC_APP_LINK_BASE=http://localhost:3000   # base for links in emails (verify/reset/invite)
CORS_ORIGINS=                        # usually empty: mobile needs no CORS, admin uses a server-side BFF
TRUST_PROXY=false                    # true behind a TLS-terminating load balancer

# Email: smtp (Mailpit locally on 1025, real provider in prod) or memory (dev/test only, never "sends")
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Bitaqati <no-reply@your-domain.example>

# Push: expo (Expo Push Service → APNs) or log (dev only, recorded as SIMULATED, never as SENT)
PUSH_PROVIDER=log
EXPO_ACCESS_TOKEN=<optional: Expo access token if push security is enabled>

# Storage: s3 (required in staging/production; MinIO locally) or local (development only)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000    # empty for AWS S3
S3_REGION=auto
S3_BUCKET=bitaqati-dev
S3_ACCESS_KEY_ID=<access key>
S3_SECRET_ACCESS_KEY=<secret key>
S3_FORCE_PATH_STYLE=true

# Business defaults (admin settings override at runtime)
DEFAULT_TIMEZONE=Asia/Hebron
QR_TTL_SECONDS=60
VERIFICATION_TTL_SECONDS=900
QUOTE_TTL_SECONDS=600
MAX_INVOICE_MINOR=5000000            # 50,000.00 ₪ operational ceiling per invoice
LOG_LEVEL=info

# Seed (development/staging/review only)
SEED_ADMIN_PASSWORD=<only needed outside development>
SEED_REVIEW_USER_PASSWORD=<App Review member password>
SEED_REVIEW_MERCHANT_PASSWORD=<App Review cashier password>

# --- Admin web (apps/admin) ---
API_INTERNAL_URL=http://localhost:4000   # server-to-server URL of the API (required in production)

# --- Mobile (apps/mobile, set as EAS environment variables) ---
EXPO_PUBLIC_API_URL=http://localhost:4000
IOS_BUNDLE_ID=<reverse-DNS id owned by the app owner, e.g. com.company.bitaqati>
APP_DISPLAY_NAME=بطاقتي
EAS_PROJECT_ID=<EAS project id, required for push tokens>
