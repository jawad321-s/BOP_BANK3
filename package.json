{
  "name": "bitaqati",
  "private": true,
  "version": "0.1.0",
  "description": "Bitaqati digital discount card platform (API, admin web, mobile app)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:shared": "pnpm --filter @bitaqati/shared build",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @bitaqati/api dev",
    "dev:worker": "pnpm --filter @bitaqati/api dev:worker",
    "dev:admin": "pnpm --filter @bitaqati/admin dev",
    "dev:mobile": "pnpm --filter @bitaqati/mobile start",
    "db:migrate": "pnpm --filter @bitaqati/api db:migrate",
    "db:seed": "pnpm --filter @bitaqati/api db:seed"
  }
}
