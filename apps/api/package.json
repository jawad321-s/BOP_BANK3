{
  "name": "@bitaqati/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "ts-node --transpile-only src/main.ts",
    "dev:worker": "ts-node --transpile-only src/worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "openapi": "ts-node --transpile-only src/openapi.ts",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPatterns=unit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@bitaqati/shared": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "bullmq": "5.81.5",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nodemailer": "7.0.13",
    "otplib": "12.0.1",
    "pino": "9.14.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.5",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.0.0",
    "@types/node": "22.20.4",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "8.15.5",
    "pg": "8.16.3",
    "@types/supertest": "6.0.3",
    "jest": "30.2.0",
    "prisma": "6.19.3",
    "supertest": "7.3.0",
    "ts-jest": "29.4.5",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
}
